# Copy to the repo root as .env.prod and fill in real values.
#   cp deploy/env.prod.example .env.prod
# Never commit .env.prod.

# Public DNS name of the IdP (no https://). Caddy obtains a certificate for this host.
OIH_PUBLIC_HOST=idp.example.com

# Must be HTTPS and must match the public URL. Wrong values break SAML Destination checks.
OIH_ENTITY_ID=https://idp.example.com/saml2/idp/metadata
OIH_BASE_URL=https://idp.example.com

# One-time first-run token. Generate with: openssl rand -base64 24
OIH_SETUP_TOKEN=replace-with-unique-setup-token

# 32-byte key, base64. Generate with: openssl rand -base64 32
OIH_TOTP_WRAP_KEY=replace-with-32-byte-base64

# PKCS#11 user PIN and Security Officer PIN (SoftHSM). Generate separately.
OIH_HSM_PIN=replace-hsm-user-pin
OIH_HSM_SO_PIN=replace-hsm-so-pin
OIH_HSM_LIBRARY=/usr/lib/x86_64-linux-gnu/softhsm/libsofthsm2.so
OIH_HSM_SLOT_LIST_INDEX=0

# PostgreSQL
POSTGRES_USER=oih
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=oih_idp
SPRING_DATASOURCE_USERNAME=oih
SPRING_DATASOURCE_PASSWORD=replace-with-strong-db-password
